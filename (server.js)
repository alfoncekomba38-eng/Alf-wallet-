const express = require("express");
const db = require("./admin");

const app = express();
app.use(express.json());

const MINING_REWARD = 10;
const COOLDOWN = 24 * 60 * 60 * 1000;

// ⛏ MINING ENDPOINT
app.post("/mine", async (req, res) => {
  try {
    const { userId } = req.body;

    // ✅ validation
    if (!userId || typeof userId !== "string") {
      return res.json({
        success: false,
        message: "Valid userId required",
      });
    }

    const userRef = db.collection("users").doc(userId);
    const userSnap = await userRef.get();

    if (!userSnap.exists) {
      return res.json({
        success: false,
        message: "User not found",
      });
    }

    const user = userSnap.data();
    const now = Date.now();
    const lastMine = user.lastMineTime || 0;

    // ⏳ cooldown check
    if (now - lastMine < COOLDOWN) {
      const remaining = COOLDOWN - (now - lastMine);

      return res.json({
        success: false,
        message: "Wait before next mine",
        remainingTime: remaining,
      });
    }

    // 💰 update balance
    const newBalance = (user.balance || 0) + MINING_REWARD;

    await userRef.update({
      balance: newBalance,
      lastMineTime: now,
    });

    return res.json({
      success: true,
      message: "Mining successful",
      reward: MINING_REWARD,
      balance: newBalance,
    });

  } catch (error) {
    console.error("Mining error:", error);

    return res.json({
      success: false,
      message: "Server error, try again later",
    });
  }
});

// 🚀 START SERVER
const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`ALF Mining server running on port ${PORT}`);
});
